# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# IDs de Telegram autorizados (separados por coma, sin espacios)
# Ejemplo: AUTHORIZED_USERS=123456789,987654321
AUTHORIZED_USERS=

# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./app/database/certificados.db

# ─── Rutas ───────────────────────────────────────────────────────────────────
DOCUMENTS_DIR=documentos
BACKUPS_DIR=backups
TEMPLATES_DIR=app/templates

# ─── Aplicación ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── API (opcional, para integraciones futuras) ──────────────────────────────
API_SECRET_KEY=change_this_to_a_random_secret_key
API_HOST=0.0.0.0
API_PORT=8000
